<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>MY SHORTCUTS</string>
			<key>footerText</key>
			<string>Load names, identifiers, and icons from My Shortcuts into a local cache. The database is read only when this button is tapped. Loading never assigns Shortcuts to a module.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Load My Shortcuts</string>
			<key>action</key>
			<string>loadMyShortcuts</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>CONTROL CENTER MODULES</string>
			<key>footerText</key>
			<string>Each module holds its own list of Shortcuts. Add them in Settings → Control Center. Respring only if a module does not show up there.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
