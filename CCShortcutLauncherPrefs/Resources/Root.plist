			<string>ModuleSlotCount</string>
			<key>defaults</key>
			<string>com.dinhnguyenx.ccshortcutlauncher</string>
			<key>default</key>
			<integer>2</integer>
			<key>detail</key>
			<string>PSListItemsController</string>
